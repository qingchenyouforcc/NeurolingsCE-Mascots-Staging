# Copy to a private location and fill in real values. Never commit real values.
SUBMISSION_ENV=production
SUBMISSION_PORT=8000
SUBMISSION_STORAGE_DIR=/var/lib/neurolingsce-submissions
SUBMISSION_BASE_URL=https://submissions.example.com

# Publisher GitHub App (server-only; never used by the desktop client)
GITHUB_PUBLISHER_APP_ID=
GITHUB_PUBLISHER_INSTALLATION_ID=
GITHUB_PUBLISHER_PRIVATE_KEY_PATH=/run/secrets/publisher-app-key.pem

GITHUB_OWNER=qingchenyouforcc
GITHUB_REPO=NeurolingsCE-Mascots

# Production requires a fixed session secret: hex (>=64 chars) or base64
# decoding to at least 32 bytes. No default/temporary key is allowed.
SUBMISSION_SESSION_SECRET=
SUBMISSION_SESSION_TTL_SECONDS=600

# Production requires a working public validator; startup self-check runs it.
VALIDATOR_CLI=/opt/neurolingsce/bin/NeurolingsCE-cli
VALIDATOR_TIMEOUT_SECONDS=120

MAX_UPLOAD_BYTES=104857600
RATE_LIMIT_SUBMISSIONS_PER_MINUTE=10
SUBMISSION_AUTH_RATE_LIMIT_PER_MINUTE=30
